{
  "manifest_version": 3,
  "name": "ChatGPT 提问时间线",
  "version": "1.1.0",
  "description": "在 ChatGPT 右侧快速预览、定位自己的提问。轻量、本地运行。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ChatGPT Voyager · 提问时间线",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js", "return-origin.js"],
      "run_at": "document_idle"
    }
  ]
}
