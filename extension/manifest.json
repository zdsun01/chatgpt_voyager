{
  "manifest_version": 3,
  "name": "ChatGPT 提问时间线",
  "version": "1.0.13",
  "description": "在 ChatGPT 右侧快速预览、定位自己的提问。轻量、本地运行。",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
